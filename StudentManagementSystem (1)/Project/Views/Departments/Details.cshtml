@model Department
@{
    ViewData["Title"] = "Department Details";
}

<h2 class="fw-bold mb-4" style="color:#0F2D5A;"><i class="bi bi-building"></i> @Model.DepartmentName</h2>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header text-white" style="background-color:#0F2D5A;">Students in this Department</div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light"><tr><th>Reg #</th><th>Name</th></tr></thead>
                    <tbody>
                        @if (Model.Students != null && Model.Students.Any())
                        {
                            @foreach (var s in Model.Students)
                            {
                                <tr><td>@s.RegistrationNumber</td><td>@s.FullName</td></tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="2" class="text-center text-muted py-3">No students yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header text-white" style="background-color:#0F2D5A;">Courses in this Department</div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light"><tr><th>Code</th><th>Course Name</th></tr></thead>
                    <tbody>
                        @if (Model.Courses != null && Model.Courses.Any())
                        {
                            @foreach (var c in Model.Courses)
                            {
                                <tr><td>@c.CourseCode</td><td>@c.CourseName</td></tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="2" class="text-center text-muted py-3">No courses yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<a asp-action="Index" class="btn btn-outline-secondary mt-3">Back to List</a>
