@model Student
@{
    ViewData["Title"] = "Delete Student";
}

<h2 class="fw-bold mb-4 text-danger"><i class="bi bi-exclamation-triangle"></i> Delete Student</h2>

<div class="card border-0 shadow-sm border-danger">
    <div class="card-body">
        <p class="lead">Are you sure you want to delete this student record? This action cannot be undone.</p>

        <table class="table table-borderless">
            <tr><th style="width:200px;">Registration #</th><td>@Model.RegistrationNumber</td></tr>
            <tr><th>Name</th><td>@Model.FullName</td></tr>
            <tr><th>Email</th><td>@Model.Email</td></tr>
            <tr><th>Department</th><td>@Model.Department?.DepartmentName</td></tr>
        </table>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="StudentId" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Yes, Delete
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
