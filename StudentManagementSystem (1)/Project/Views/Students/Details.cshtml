@model Student
@{
    ViewData["Title"] = "Student Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold" style="color:#0F2D5A;"><i class="bi bi-person-badge"></i> Student Profile</h2>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.StudentId" class="btn btn-outline-primary">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <i class="bi bi-person-circle" style="font-size:80px;color:#1E5F9E;"></i>
                <h4 class="mt-3 fw-bold">@Model.FullName</h4>
                <p class="text-muted">@Model.RegistrationNumber</p>
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header text-white" style="background-color:#0F2D5A;">
                <i class="bi bi-info-circle"></i> Personal Information
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr><th style="width:200px;">Email</th><td>@Model.Email</td></tr>
                    <tr><th>Phone</th><td>@(Model.PhoneNumber ?? "—")</td></tr>
                    <tr><th>Date of Birth</th><td>@Model.DateOfBirth.ToString("dd MMM yyyy") (Age: @Model.Age)</td></tr>
                    <tr><th>Gender</th><td>@Model.Gender</td></tr>
                    <tr><th>Address</th><td>@(Model.Address ?? "—")</td></tr>
                    <tr><th>Department</th><td>@Model.Department?.DepartmentName</td></tr>
                    <tr><th>Enrollment Date</th><td>@Model.EnrollmentDate.ToString("dd MMM yyyy")</td></tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header text-white d-flex justify-content-between" style="background-color:#0F2D5A;">
                <span><i class="bi bi-journal-bookmark"></i> Enrolled Courses</span>
                <a asp-action="Enroll" asp-route-id="@Model.StudentId" class="text-white text-decoration-none">
                    <i class="bi bi-plus-circle"></i> Enroll in Course
                </a>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Course Code</th>
                            <th>Course Name</th>
                            <th>Semester</th>
                            <th>Grade</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Enrollments != null && Model.Enrollments.Any())
                        {
                            @foreach (var e in Model.Enrollments)
                            {
                                <tr>
                                    <td>@e.Course?.CourseCode</td>
                                    <td>@e.Course?.CourseName</td>
                                    <td>@e.Semester</td>
                                    <td>
                                        @if (string.IsNullOrEmpty(e.Grade))
                                        {
                                            <span class="badge bg-warning text-dark">In Progress</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">@e.Grade</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center text-muted py-3">No courses enrolled yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
